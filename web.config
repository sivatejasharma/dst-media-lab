<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS Web.config for Video Merger API & UI
  Uses IIS URL Rewrite + ARR (Application Request Routing) as a Reverse Proxy
  to forward requests to the Node.js Express application running on port 3000 (PM2 service).
-->
<configuration>
  <system.webServer>
    <!-- Configure Max Request Payload to 200MB (209715200 bytes) for video uploads -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>

    <!-- Configure URL Rewrite Rules -->
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
